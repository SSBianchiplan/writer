# GPlanSiS|Writer — variáveis da API (server/app.py). Copie para .env e ajuste.
# Valores abaixo são FICTÍCIOS. Nunca publique o .env real.

# Conexão PostgreSQL (psycopg). Produção usa socket local sem senha: postgresql:///writer?host=/var/run/postgresql
WRITER_DSN=postgresql://writer@127.0.0.1:5432/writer

# E-mail do administrador master (não pode ser rebaixado, desativado nem perder permissões)
WRITER_MASTER=admin@exemplo.com

# Duração da sessão, em horas
WRITER_SESSAO_HORAS=12

# 1 = cookie de sessão só por HTTPS (produção). Use 0 para rodar em http://localhost
WRITER_COOKIE_SEGURO=1

# Chave Fernet que cifra a chave da IA guardada pelo painel. Gere com:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WRITER_SEGREDO=troque-por-uma-chave-fernet

# Assistente IA (opcional). Prefira colar a chave em Configurações › Assistente IA; esta é a reserva.
ANTHROPIC_API_KEY=
WRITER_IA_MODELO=claude-opus-5-5

# Integração com o GPlanSiS|Docs (opcional; vazio = desligada)
WRITER_DOCS_SEGREDO=
WRITER_DOCS_URL=https://docs.exemplo.com
WRITER_DOCS_API=http://127.0.0.1:8945/api
WRITER_URL=https://writer.exemplo.com
